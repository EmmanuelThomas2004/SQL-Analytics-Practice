-- 1. Find total sales by customer
SELECT
    customer_id,
    SUM(sales_amount) AS total_sales
FROM orders
GROUP BY customer_id;

-- 2. Find customers with sales greater than 50000
SELECT
    customer_id,
    SUM(sales_amount) AS total_sales
FROM orders
GROUP BY customer_id
HAVING SUM(sales_amount) > 50000;

-- 3. Find the top 5 products by revenue
SELECT TOP 5
    product_id,
    SUM(sales_amount) AS revenue
FROM orders
GROUP BY product_id
ORDER BY revenue DESC;

-- 4. Find average order value by region
SELECT
    region,
    AVG(order_amount) AS avg_order_value
FROM orders
GROUP BY region;

-- 5. Rank customers based on total sales
SELECT
    customer_id,
    SUM(sales_amount) AS total_sales,
    RANK() OVER (ORDER BY SUM(sales_amount) DESC) AS sales_rank
FROM orders
GROUP BY customer_id;

-- 6. Find employees earning more than their department average
SELECT
    employee_id,
    employee_name,
    salary,
    department_id
FROM employees e
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
    WHERE department_id = e.department_id
);
